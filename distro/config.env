# SPDX-License-Identifier: GPL-3.0-or-later
# Cin-MinAI distro build configuration (M1). Sourced by the scripts in this directory.
# Everything that decides what goes into the ISO is pinned here or in git.

# Our version (packages and ISO). The ISO's dates come from the last git commit (SOURCE_DATE_EPOCH).
CINMINAI_VERSION=0.0.1
# The packages' own version: the release plus the last commit's time (UTC), so every build from a new commit is a
# distinct, newer version (2026-10-03: every build was "0.0.1", and a package that wasn't installed didn't show).
# Commit before building. Packages depend on each other at >= the release, so one can be updated on its own.
CINMINAI_PKG_VERSION=${CINMINAI_PKG_VERSION:-$CINMINAI_VERSION+git$(date -u -d "@$(git -c safe.directory="*" -C "$(dirname "${BASH_SOURCE[0]}")" log -1 --format=%ct)" +%Y%m%d.%H%M%S)}

# Upstream ISO (pinned; verified by SHA-256 before use).
MINT_VERSION=22.3
MINT_ISO=linuxmint-22.3-cinnamon-64bit.iso
MINT_ISO_SHA256=a081ab202cfda17f6924128dbd2de8b63518ac0531bcfe3f1a1b88097c459bd4
MINT_MIRROR=https://mirrors.kernel.org/linuxmint/stable/22.3

# Work area on the WSL ext4 disk (not /mnt/c: chroot, device nodes, speed). The upstream ISO is shared
# with the M0 spike's cache; everything M1 builds goes under $WORK/m1.
WORK=${WORK:-$HOME/cinminai-build}
M1=$WORK/m1

# Our apt repository (PLAN D46: GitHub Pages, public repo cinminai-apt). The installed system fetches
# updates from REPO_URL; during the ISO build the same repo is bind-mounted into the chroot instead.
REPO_URL=${REPO_URL:-https://brickmii.github.io/cinminai-apt}
REPO_SUITE=noble
REPO_COMPONENT=main

# Signing. Default: a development key made on first use, labelled "not for release" — the release key
# is kept offline and signs through a subkey (PLAN M1). Override with SIGNING_GNUPGHOME + SIGNING_KEY.
SIGNING_GNUPGHOME=${SIGNING_GNUPGHOME:-$M1/gnupg-dev}
SIGNING_KEY=${SIGNING_KEY:-cinminai-dev}

# llama.cpp (cinminai-llama, PLAN D5): the release the guide was measured with (MODEL_CARD.md), built in a
# clean Ubuntu 24.04 build root whose packages come from a dated Ubuntu snapshot (build-llama.sh).
LLAMA_REPO=https://github.com/ggml-org/llama.cpp
LLAMA_TAG=v0.5.0
LLAMA_COMMIT=7fe450e19305b828c199d602c23a8337aaa1f03b
# NVIDIA: machine code for Pascal (GTX 10xx, the Mint box), Turing (GTX 16xx/RTX 20xx), Ampere (RTX 30xx) and
# Ada (RTX 40xx); PTX for Maxwell (GTX 9xx) and for cards newer than CUDA 12.0 knows (compiled by the driver).
LLAMA_CUDA_ARCHS="52-virtual;61-real;75-real;86-real;89-real;89-virtual"
UBUNTU_BASE_URL=https://cdimage.ubuntu.com/ubuntu-base/releases/24.04/release/ubuntu-base-24.04.5-base-amd64.tar.gz
UBUNTU_BASE_SHA256=e77b6f10c2590cef872b33ee9f635a0e3fd1f57fb074c0e52b5c7f56147a0c86
UBUNTU_SNAPSHOT=20260927T000000Z

# The guide model (PLAN D23, D43, D46): on the ISO as its own file (/cinminai/models/), and fetched by
# cinminai-guide-model on installed systems. GUIDE_URL is empty until the Hugging Face repository exists
# (waiting on Ian); the build takes the file from GUIDE_LOCAL and checks it against GUIDE_SHA256.
GUIDE_FILE=Qwen3.5-4B-guide-HO-Q4_K_M.gguf
GUIDE_SIZE=2783446848
GUIDE_SHA256=b9b132b05530879ae528dbd195161398b69768fa87b347ffd92a2b6f67e8c8e4
GUIDE_URL=${GUIDE_URL:-}
GUIDE_LOCAL=${GUIDE_LOCAL:-$HOME/cinminai-train/out/$GUIDE_FILE}

# Output.
OUT_ISO=cinminai-${CINMINAI_VERSION}-amd64.iso
