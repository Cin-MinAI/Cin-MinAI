#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e
if [ "$1" = remove ] || [ "$1" = deconfigure ]; then
    systemctl stop cinminai-admin.service >/dev/null 2>&1 || true
fi
find /usr/lib/python3/dist-packages/cin_minai/admin -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
