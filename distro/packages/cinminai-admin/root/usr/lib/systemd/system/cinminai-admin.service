[Unit]
Description=Cin-MinAI admin mechanism (polkit-checked, D-Bus activated)
Documentation=https://github.com/Cin-MinAI/Cin-MinAI

[Service]
Type=dbus
BusName=org.cinminai.Admin1
ExecStart=/usr/libexec/cinminai/cinminai-admin
User=root
Group=root
PrivateTmp=yes
ProtectHome=yes
# No ProtectKernelTunables: it makes /sys read-only, and package scripts run through
# InstallPackage call `udevadm trigger ... || true` (libfprint, udisks2, dmraid on the
# test SSD) - the install "succeeds" but the device stays unset until a reboot. apt
# maintainer scripts run as root anyway, so it bought little here.
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
LockPersonality=yes
UMask=0022
