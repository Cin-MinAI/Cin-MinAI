#!/usr/bin/python3 -P
# SPDX-License-Identifier: GPL-3.0-or-later
"""Git's credential helper for GitHub, from the computer's GitHub link (docs/accounts-and-cloud.md).

    git -c credential.helper= -c 'credential.helper=!/usr/libexec/cinminai-git-credential' push

Only `get` for https://github.com is answered: the access token from the login keyring, renewed first when it's due.
Nothing is stored by git (store/erase are ignored), nothing is printed but to git itself.
"""
import sys


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] != "get":
        return 0
    asked = dict(line.rstrip("\n").split("=", 1) for line in sys.stdin if "=" in line)
    if asked.get("protocol") != "https" or asked.get("host") != "github.com":
        return 0
    from cin_minai.daemon.accounts import AccountError, github
    try:
        token = github.token()
    except AccountError as e:
        sys.stderr.write(f"Cin-MinAI: {e}\n")
        return 0  # git then says it couldn't sign in
    sys.stdout.write(f"username=x-access-token\npassword={token}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
