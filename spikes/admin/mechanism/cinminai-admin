#!/usr/bin/python3
"""cinminai-admin — the ADMIN-lane mechanism (M0 spike, SPEC §8.4).

Root-owned, D-Bus-activated system service `org.cinminai.Admin1`. Fixed verbs only; every call:
  1. validates its arguments (refuses protected targets before polkit is even asked),
  2. asks polkit for the verb's own action with the caller as subject (auth_admin, never _keep),
     interactive only if the caller set ALLOW_INTERACTIVE_AUTHORIZATION on the message,
  3. runs a fixed argv (no shell), and
  4. appends a JSON line to the audit log (/var/log/cinminai/admin.log).
Exits after IDLE_EXIT seconds without requests; D-Bus starts it again on the next call.
"""

from __future__ import annotations

import datetime
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import threading
import time
import uuid

from gi.repository import Gio, GLib

NAME = "org.cinminai.Admin1"
PATH = "/org/cinminai/Admin1"
IFACE = "org.cinminai.Admin1"
AUDIT = os.environ.get("CINMINAI_ADMIN_AUDIT", "/var/log/cinminai/admin.log")
BACKUPS = "/var/lib/cinminai/admin-backups"
IDLE_EXIT = int(os.environ.get("CINMINAI_ADMIN_IDLE", "60"))
ERR = "org.cinminai.Admin1.Error"

XML = f"""
<node>
  <interface name="{IFACE}">
    <method name="RestartService"><arg type="s" name="unit" direction="in"/></method>
    <method name="SetServiceEnabled">
      <arg type="s" name="unit" direction="in"/><arg type="b" name="enabled" direction="in"/>
    </method>
    <method name="InstallPackage">
      <arg type="s" name="package" direction="in"/><arg type="s" name="log" direction="out"/>
    </method>
    <method name="RemovePackage">
      <arg type="s" name="package" direction="in"/><arg type="s" name="log" direction="out"/>
    </method>
    <method name="WriteFile">
      <arg type="s" name="path" direction="in"/><arg type="ay" name="content" direction="in"/>
      <arg type="u" name="mode" direction="in"/><arg type="s" name="backup" direction="out"/>
    </method>
    <property name="Version" type="s" access="read"/>
  </interface>
</node>
"""

# --- validation --------------------------------------------------------------------------------

UNIT_RE = re.compile(r"^[A-Za-z0-9@_.:\-]{1,200}\.(service|socket|timer|path|target)$")
PROTECTED_UNITS = re.compile(
    r"^(dbus|dbus-broker|polkit|systemd-.*|user@.*|user-runtime-dir@.*|getty@.*|"
    r"lightdm|gdm3?|sddm|display-manager|cinminai-admin)\.")
PKG_RE = re.compile(r"^[a-z0-9][a-z0-9+.\-]{0,99}$")
PROTECTED_PKGS = re.compile(
    r"^(apt|dpkg|bash|coreutils|dbus.*|libc6|linux-image.*|linux-generic.*|login|passwd|polkitd|"
    r"pkexec|sudo|systemd.*|cinnamon.*|mint-.*|lightdm|cinminai-.*|base-files|init|ubuntu-keyring)$")
WRITE_ROOT = "/etc/"
PROTECTED_PATHS = ("/etc/sudoers", "/etc/sudoers.d", "/etc/shadow", "/etc/gshadow", "/etc/passwd",
                   "/etc/group", "/etc/polkit-1", "/etc/pam.d", "/etc/security", "/etc/dbus-1",
                   "/etc/systemd", "/etc/apt", "/etc/cinminai", "/etc/ld.so", "/etc/profile",
                   "/etc/environment", "/etc/crontab", "/etc/cron.", "/etc/fstab", "/etc/default/grub",
                   "/etc/grub.d", "/etc/modprobe.d", "/etc/udev")
MAX_WRITE = 1 << 20


class Reject(Exception):
    pass


def check_unit(unit: str) -> str:
    if not UNIT_RE.match(unit):
        raise Reject(f"not a unit name: {unit!r}")
    if PROTECTED_UNITS.match(unit):
        raise Reject(f"{unit} is protected (restarting it would break the session or this mechanism)")
    return unit


def check_package(pkg: str, removing: bool = False) -> str:
    if not PKG_RE.match(pkg):
        raise Reject(f"not a package name: {pkg!r}")
    if removing and PROTECTED_PKGS.match(pkg):
        raise Reject(f"{pkg} is protected and can't be removed through the assistant")
    return pkg


def check_write(path: str, content: bytes, mode: int) -> str:
    if not path.startswith(WRITE_ROOT) or os.path.normpath(path) != path or "\0" in path:
        raise Reject(f"only normalized absolute paths under {WRITE_ROOT} can be written: {path!r}")
    if any(path == p or path.startswith(p if p.endswith(".") else p + "/") or path.startswith(p + ".")
           for p in PROTECTED_PATHS):
        raise Reject(f"{path} is protected")
    parent = os.path.dirname(path)
    if os.path.realpath(parent) != parent:
        raise Reject(f"{parent} is (or goes through) a symlink")
    if os.path.islink(path):
        raise Reject(f"{path} is a symlink")
    if os.path.exists(path) and not stat.S_ISREG(os.lstat(path).st_mode):
        raise Reject(f"{path} is not a regular file")
    if len(content) > MAX_WRITE:
        raise Reject(f"content too large ({len(content)} bytes)")
    if mode not in (0o644, 0o640, 0o600):
        raise Reject(f"mode {oct(mode)} not allowed (0644, 0640, 0600)")
    return path


# --- actions (run only after polkit said yes) ---------------------------------------------------

def run(argv: list[str], timeout: int = 900) -> str:
    env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8",
           "DEBIAN_FRONTEND": "noninteractive"}
    r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=env)
    out = (r.stdout + r.stderr)[-8000:]
    if r.returncode != 0:
        raise RuntimeError(f"{argv[0]} exited {r.returncode}: {out.strip()[-500:]}")
    return out


def write_file(path: str, content: bytes, mode: int) -> str:
    backup = ""
    if os.path.exists(path):
        os.makedirs(BACKUPS, mode=0o700, exist_ok=True)
        # Unique even for several writes in the same second (a collision would fail an approved write).
        stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
        backup = os.path.join(BACKUPS, f"{stamp}-{uuid.uuid4().hex[:6]}{path.replace('/', '_')}")
        with open(path, "rb") as src, open(backup, "xb") as dst:
            dst.write(src.read())
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".cinminai-")
    try:
        os.write(fd, content)
        os.fchmod(fd, mode)
        os.fsync(fd)
        os.close(fd)
        os.rename(tmp, path)  # atomic; replaces, never follows a symlink at `path`
    except BaseException:
        os.unlink(tmp)
        raise
    return backup


VERBS = {
    # method: (polkit action, validate(args) -> details, act(args) -> return value, D-Bus out sig)
    "RestartService": ("org.cinminai.admin.restart-service",
                       lambda a: {"unit": check_unit(a[0])},
                       lambda a: (run(["systemctl", "restart", "--", a[0]]), None)[1], None),
    "SetServiceEnabled": ("org.cinminai.admin.set-service-enabled",
                          lambda a: {"unit": check_unit(a[0]), "enabled": "yes" if a[1] else "no"},
                          lambda a: (run(["systemctl", "enable" if a[1] else "disable", "--", a[0]]), None)[1],
                          None),
    "InstallPackage": ("org.cinminai.admin.install-package",
                       lambda a: {"package": check_package(a[0])},
                       lambda a: run(["apt-get", "install", "-y", "--no-install-recommends",
                                      "-o", "Dpkg::Options::=--force-confold", "--", a[0]]), "(s)"),
    "RemovePackage": ("org.cinminai.admin.remove-package",
                      lambda a: {"package": check_package(a[0], removing=True)},
                      lambda a: run(["apt-get", "remove", "-y", "--no-auto-remove", "--", a[0]]), "(s)"),
    "WriteFile": ("org.cinminai.admin.write-file",
                  lambda a: {"path": check_write(a[0], bytes(a[1]), a[2]), "size": str(len(a[1])),
                             "mode": oct(a[2])},
                  lambda a: write_file(a[0], bytes(a[1]), a[2]), "(s)"),
}


# --- service -----------------------------------------------------------------------------------

class Mechanism:
    def __init__(self, loop: GLib.MainLoop) -> None:
        self.loop = loop
        self.conn: Gio.DBusConnection | None = None
        self.inflight = 0
        self.last = time.monotonic()
        GLib.timeout_add_seconds(5, self.idle_check)

    def idle_check(self) -> bool:
        if not self.inflight and time.monotonic() - self.last > IDLE_EXIT:
            self.loop.quit()
            return False
        return True

    def audit(self, **rec) -> None:
        rec = {"ts": datetime.datetime.now().astimezone().isoformat(timespec="seconds"), **rec}
        os.makedirs(os.path.dirname(AUDIT), mode=0o750, exist_ok=True)
        fd = os.open(AUDIT, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o640)
        try:
            os.write(fd, (json.dumps(rec, sort_keys=False) + "\n").encode())
        finally:
            os.close(fd)

    def caller(self, sender: str) -> dict:
        def ask(method: str):
            return self.conn.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                                       method, GLib.Variant("(s)", (sender,)), None,
                                       Gio.DBusCallFlags.NONE, 2000, None).unpack()[0]
        uid, pid = ask("GetConnectionUnixUser"), ask("GetConnectionUnixProcessID")
        try:
            exe = os.readlink(f"/proc/{pid}/exe")
        except OSError:
            exe = "?"
        return {"uid": uid, "pid": pid, "exe": exe}

    def acquired(self, conn, name) -> None:
        self.conn = conn
        info = Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0]
        conn.register_object(PATH, info, self.call, lambda *a: GLib.Variant("s", "0.1-spike"), None)

    def call(self, conn, sender, path, iface, method, params, inv) -> None:
        self.last = time.monotonic()
        action, validate, act, out_sig = VERBS[method]
        args = params.unpack()
        shown = [a if not isinstance(a, (bytes, list)) else f"<{len(a)} bytes>" for a in args]
        who = self.caller(sender)
        base = {"verb": method, "args": shown, "caller": who}
        try:
            details = validate(args)
        except Reject as e:
            self.audit(**base, decision="rejected", reason=str(e))
            inv.return_dbus_error(f"{ERR}.Rejected", str(e))
            return
        interactive = bool(inv.get_message().get_flags() & Gio.DBusMessageFlags.ALLOW_INTERACTIVE_AUTHORIZATION)
        self.inflight += 1
        self.check_auth(sender, action, details, interactive,
                        lambda ok, why: self.after_auth(ok, why, inv, base, details, act, args, out_sig))

    def check_auth(self, sender, action, details, interactive, done) -> None:
        subject = ("system-bus-name", {"name": GLib.Variant("s", sender)})
        flags = 1 if interactive else 0  # AllowUserInteraction
        cancel_id = uuid.uuid4().hex

        def reply(bus, res) -> None:
            try:
                authorized, challenge, pk_details = bus.call_finish(res).unpack()[0]
            except GLib.Error as e:
                done(False, f"polkit error: {e.message}")
                return
            if authorized:
                done(True, "authorized")
            elif pk_details.get("polkit.dismissed"):
                done(False, "dismissed")  # the user cancelled the password dialog
            elif challenge:
                done(False, "challenge (no authentication agent, or not interactive)")
            else:
                done(False, "denied")

        self.conn.call("org.freedesktop.PolicyKit1", "/org/freedesktop/PolicyKit1/Authority",
                       "org.freedesktop.PolicyKit1.Authority", "CheckAuthorization",
                       GLib.Variant("((sa{sv})sa{ss}us)", (subject, action, details, flags, cancel_id)),
                       GLib.VariantType("((bba{ss}))"), Gio.DBusCallFlags.NONE,
                       0x7fffffff, None, reply)  # the user may take a while to type the password

    def after_auth(self, ok, why, inv, base, details, act, args, out_sig) -> None:
        if not ok:
            self.inflight -= 1
            self.audit(**base, details=details, decision=why)
            name = "Dismissed" if why == "dismissed" else "NotAuthorized"
            inv.return_dbus_error(f"{ERR}.{name}", f"not authorized: {why}")
            return
        t0 = time.monotonic()

        def work() -> None:
            try:
                value, error = act(args), None
            except Exception as e:  # report every failure to the caller and the log
                value, error = None, str(e)
            GLib.idle_add(finish, value, error)

        def finish(value, error) -> bool:
            self.inflight -= 1
            self.last = time.monotonic()
            self.audit(**base, details=details, decision="authorized",
                       result="error" if error else "ok", error=error,
                       seconds=round(time.monotonic() - t0, 2))
            if error:
                inv.return_dbus_error(f"{ERR}.Failed", error)
            elif out_sig:
                inv.return_value(GLib.Variant(out_sig, (value or "",)))
            else:
                inv.return_value(None)
            return False

        threading.Thread(target=work, daemon=True).start()


def main() -> int:
    if os.geteuid() != 0:
        print("cinminai-admin must run as root (D-Bus activated)", file=sys.stderr)
        return 1
    os.umask(0o022)
    loop = GLib.MainLoop()
    m = Mechanism(loop)
    Gio.bus_own_name(Gio.BusType.SYSTEM, NAME, Gio.BusNameOwnerFlags.NONE, m.acquired, None,
                     lambda *a: loop.quit())
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
