# ISO remaster spike configuration. Sourced by the scripts in this directory.

# Upstream ISO (pinned).
MINT_VERSION=22.3
MINT_ISO=linuxmint-22.3-cinnamon-64bit.iso
MINT_ISO_SHA256=a081ab202cfda17f6924128dbd2de8b63518ac0531bcfe3f1a1b88097c459bd4
MINT_MIRROR=https://mirrors.kernel.org/linuxmint/stable/22.3

# Work area on the WSL ext4 disk (not /mnt/c: chroot, device nodes, and speed).
WORK=${WORK:-$HOME/cinminai-build}

# Our apt repository. The installed system fetches updates from REPO_URL;
# during the build the same repo is bind-mounted into the chroot instead.
REPO_SUITE=noble
REPO_COMPONENT=main
REPO_URL=${REPO_URL:-http://cinminai-repo.invalid/apt}

# Output.
OUT_ISO=cinminai-spike-${MINT_VERSION}-amd64.iso
OUT_VOLID=CINMINAI_SPIKE
